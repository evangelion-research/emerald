# strings — the `str` operations Python spells as methods.
#
# There are no methods, so the subject is always the first parameter:
# `strings.split(s, ",")` rather than `s.split(",")`.
#
# `slice` is a builtin (it needs one memcpy, not a loop of concatenations), so
# there is no `strings.slice`. Bytes, not codepoints, throughout — see
# stdlib/SPEC.md D1.

import chars
import builder
from result import Result

# --- searching (pure: these only read) ------------------------------------

def find_from(s: str, needle: str, start: int) -> int pure {
    n = len(needle)
    if n == 0 { return start }
    i = start
    if i < 0 { i = 0 }
    while i + n <= len(s) {
        if slice(s, i, i + n) == needle { return i }
        i = i + 1
    }
    return -1
}

def find(s: str, needle: str) -> int pure { return find_from(s, needle, 0) }

def rfind(s: str, needle: str) -> int pure {
    n = len(needle)
    if n == 0 { return len(s) }
    i = len(s) - n
    while i >= 0 {
        if slice(s, i, i + n) == needle { return i }
        i = i - 1
    }
    return -1
}

def contains(s: str, needle: str) -> bool pure { return find(s, needle) >= 0 }

def starts_with(s: str, p: str) -> bool pure {
    if len(p) > len(s) { return False }
    return slice(s, 0, len(p)) == p
}

def ends_with(s: str, p: str) -> bool pure {
    if len(p) > len(s) { return False }
    return slice(s, len(s) - len(p), len(s)) == p
}

# Non-overlapping occurrences, like Python's str.count.
def count(s: str, needle: str) -> int pure {
    if len(needle) == 0 { return 0 }
    n = 0
    i = 0
    while i <= len(s) - len(needle) {
        if slice(s, i, i + len(needle)) == needle {
            n = n + 1
            i = i + len(needle)
        } else {
            i = i + 1
        }
    }
    return n
}

def take(s: str, n: int) -> str pure { return slice(s, 0, n) }
def drop(s: str, n: int) -> str pure { return slice(s, n, len(s)) }
def char_at(s: str, i: int) -> str pure { return slice(s, i, i + 1) }

def is_empty(s: str) -> bool pure { return len(s) == 0 }

# --- splitting and joining -------------------------------------------------

def split(s: str, sep: str) -> list[str] pure {
    out: list[str] = []
    # An empty separator would mean "explode into characters", which is what
    # `for c in s` already does. Splitting on nothing returns the whole thing.
    if len(sep) == 0 {
        append(out, s)
        return out
    }
    start = 0
    while True {
        hit = find_from(s, sep, start)
        if hit < 0 {
            append(out, slice(s, start, len(s)))
            return out
        }
        append(out, slice(s, start, hit))
        start = hit + len(sep)
    }
    return out
}

# Splits on \n and tolerates \r\n. A trailing newline does not produce a final
# empty line, which is what every line-oriented tool actually wants.
def split_lines(s: str) -> list[str] pure {
    out: list[str] = []
    raw = split(s, "\n")
    i = 0
    while i < len(raw) {
        line = raw[i]
        if ends_with(line, "\r") { line = slice(line, 0, len(line) - 1) }
        if i == len(raw) - 1 and len(line) == 0 {
            i = i + 1
        } else {
            append(out, line)
            i = i + 1
        }
    }
    return out
}

# Splits on runs of whitespace, dropping empties: "  a  b " -> ["a", "b"].
def split_ws(s: str) -> list[str] {
    out: list[str] = []
    cur = builder.new()
    for c in s {
        if chars.is_space(c) {
            if builder.size(cur) > 0 {
                append(out, builder.build(cur))
                cur = builder.new()
            }
        } else {
            builder.push(cur, c)
        }
    }
    if builder.size(cur) > 0 { append(out, builder.build(cur)) }
    return out
}

def join(sep: str, parts: list[str]) -> str {
    b = builder.new()
    i = 0
    while i < len(parts) {
        if i > 0 { builder.push(b, sep) }
        builder.push(b, parts[i])
        i = i + 1
    }
    return builder.build(b)
}

# Python's str.partition, as a record because there are no tuples.
def partition(s: str, sep: str) -> { before: str, found: bool, after: str } pure {
    i = find(s, sep)
    if i < 0 { return { before: s, found: False, after: "" } }
    return { before: slice(s, 0, i),
             found: True,
             after: slice(s, i + len(sep), len(s)) }
}

# Python's str.rpartition: split at the *last* occurrence. On a miss the whole
# string lands in `after`, mirroring partition's `before`.
def rpartition(s: str, sep: str) -> { before: str, found: bool, after: str } pure {
    i = rfind(s, sep)
    if i < 0 { return { before: "", found: False, after: s } }
    return { before: slice(s, 0, i),
             found: True,
             after: slice(s, i + len(sep), len(s)) }
}

# Python's str.rsplit(sep, maxsplit): split at the rightmost `maxsplit`
# separators, so the result still has maxsplit + 1 pieces. `maxsplit <= 0`
# means "no limit", which is plain split.
def rsplit(s: str, sep: str, maxsplit: int) -> list[str] pure {
    out: list[str] = []
    if len(sep) == 0 {
        append(out, s)
        return out
    }
    if maxsplit <= 0 { return split(s, sep) }
    # Positions of every separator, left to right.
    pos: list[int] = []
    i = 0
    while i <= len(s) - len(sep) {
        if slice(s, i, i + len(sep)) == sep {
            append(pos, i)
            i = i + len(sep)
        } else {
            i = i + 1
        }
    }
    n = len(pos)
    if n <= maxsplit { return split(s, sep) }
    # Split at the last maxsplit separators; everything before the first of
    # those stays whole.
    start = 0
    j = n - maxsplit
    while j < n {
        append(out, slice(s, start, pos[j]))
        start = pos[j] + len(sep)
        j = j + 1
    }
    append(out, slice(s, start, len(s)))
    return out
}

# --- transformation --------------------------------------------------------

def lstrip(s: str) -> str pure {
    i = 0
    while i < len(s) {
        if chars.is_space(slice(s, i, i + 1)) == False { return slice(s, i, len(s)) }
        i = i + 1
    }
    return ""
}

def rstrip(s: str) -> str pure {
    i = len(s)
    while i > 0 {
        if chars.is_space(slice(s, i - 1, i)) == False { return slice(s, 0, i) }
        i = i - 1
    }
    return ""
}

def strip(s: str) -> str pure { return rstrip(lstrip(s)) }

def replace(s: str, old: str, new: str) -> str {
    if len(old) == 0 { return s }
    b = builder.new()
    i = 0
    while i < len(s) {
        if i + len(old) <= len(s) and slice(s, i, i + len(old)) == old {
            builder.push(b, new)
            i = i + len(old)
        } else {
            builder.push(b, slice(s, i, i + 1))
            i = i + 1
        }
    }
    return builder.build(b)
}

def repeat(s: str, n: int) -> str {
    b = builder.new()
    i = 0
    while i < n {
        builder.push(b, s)
        i = i + 1
    }
    return builder.build(b)
}

def upper(s: str) -> str {
    b = builder.new()
    for c in s { builder.push(b, chars.to_upper(c)) }
    return builder.build(b)
}

def lower(s: str) -> str {
    b = builder.new()
    for c in s { builder.push(b, chars.to_lower(c)) }
    return builder.build(b)
}

def reverse(s: str) -> str {
    b = builder.new()
    i = len(s) - 1
    while i >= 0 {
        builder.push(b, slice(s, i, i + 1))
        i = i - 1
    }
    return builder.build(b)
}

def pad_left(s: str, width: int, fill: str) -> str {
    if len(fill) == 0 { return s }
    if len(s) >= width { return s }
    return repeat(fill, width - len(s)) + s
}

def pad_right(s: str, width: int, fill: str) -> str {
    if len(fill) == 0 { return s }
    if len(s) >= width { return s }
    return s + repeat(fill, width - len(s))
}

# Python's str.ljust / str.rjust, under the names Python would look for.
# ljust left-justifies (pads on the right); rjust right-justifies (pads on the
# left).
def ljust(s: str, width: int, fill: str) -> str { return pad_right(s, width, fill) }
def rjust(s: str, width: int, fill: str) -> str { return pad_left(s, width, fill) }

# Python's str.center: pad on both sides, the extra space going on the right.
def center(s: str, width: int, fill: str) -> str {
    if len(fill) == 0 { return s }
    if len(s) >= width { return s }
    pad = width - len(s)
    left = int(pad / 2)
    return repeat(fill, left) + s + repeat(fill, pad - left)
}

# Python's str.zfill: zero-pad on the left, keeping a leading +/- sign in front
# of the zeros.
def zfill(s: str, width: int) -> str {
    if len(s) >= width { return s }
    pad = width - len(s)
    first = slice(s, 0, 1)
    if first == "+" or first == "-" {
        return first + repeat("0", pad) + slice(s, 1, len(s))
    }
    return repeat("0", pad) + s
}

# Python's str.expandtabs: each tab jumps the column to the next multiple of
# tabsize (default 8). A non-positive tabsize drops the tabs.
def expandtabs(s: str, tabsize: int) -> str {
    if tabsize <= 0 { return replace(s, "\t", "") }
    b = builder.new()
    col = 0
    for c in s {
        if c == "\t" {
            n = tabsize - (col % tabsize)
            builder.push(b, repeat(" ", n))
            col = col + n
        } else {
            builder.push(b, c)
            col = col + 1
        }
    }
    return builder.build(b)
}

# Python 3.9's str.removeprefix / str.removesuffix.
def removeprefix(s: str, prefix: str) -> str pure {
    if starts_with(s, prefix) { return slice(s, len(prefix), len(s)) }
    return s
}

def removesuffix(s: str, suffix: str) -> str pure {
    if ends_with(s, suffix) { return slice(s, 0, len(s) - len(suffix)) }
    return s
}

# --- casing ---------------------------------------------------------------

def capitalize(s: str) -> str {
    if len(s) == 0 { return s }
    return chars.to_upper(slice(s, 0, 1)) + lower(slice(s, 1, len(s)))
}

# Python's str.casefold is Unicode-aware; over bytes it is exactly lower.
def casefold(s: str) -> str { return lower(s) }

def swapcase(s: str) -> str {
    b = builder.new()
    for c in s {
        if chars.is_upper(c) { builder.push(b, chars.to_lower(c)) }
        elif chars.is_lower(c) { builder.push(b, chars.to_upper(c)) }
        else { builder.push(b, c) }
    }
    return builder.build(b)
}

# Python's str.title: the first letter of every run of letters is uppercased
# and the rest lowercased, so "they're" becomes "They'Re".
def title(s: str) -> str {
    b = builder.new()
    prev_alpha = False
    for c in s {
        if chars.is_alpha(c) {
            if prev_alpha { builder.push(b, chars.to_lower(c)) }
            else { builder.push(b, chars.to_upper(c)) }
            prev_alpha = True
        } else {
            builder.push(b, c)
            prev_alpha = False
        }
    }
    return builder.build(b)
}

# --- predicates (pure: these only read) -----------------------------------
#
# The whole-string versions of chars.*: chars.is_digit(c) tests one byte,
# these test every byte. Empty strings answer False everywhere except
# is_printable and is_ascii, which (like Python) are vacuously True.

def is_digit(s: str) -> bool pure {
    if len(s) == 0 { return False }
    for c in s { if chars.is_digit(c) == False { return False } }
    return True
}

def is_alpha(s: str) -> bool pure {
    if len(s) == 0 { return False }
    for c in s { if chars.is_alpha(c) == False { return False } }
    return True
}

def is_alnum(s: str) -> bool pure {
    if len(s) == 0 { return False }
    for c in s { if chars.is_alnum(c) == False { return False } }
    return True
}

def is_space(s: str) -> bool pure {
    if len(s) == 0 { return False }
    for c in s { if chars.is_space(c) == False { return False } }
    return True
}

# ASCII has no separate digit/decimal/numeric classes; all three coincide.
def is_decimal(s: str) -> bool pure { return is_digit(s) }
def is_numeric(s: str) -> bool pure { return is_digit(s) }

# Python's isupper/islower: at least one cased byte, and every cased byte on
# the requested side. Uncased bytes (digits, punctuation) are ignored.
def is_upper(s: str) -> bool pure {
    seen = False
    for c in s {
        if chars.is_lower(c) { return False }
        if chars.is_upper(c) { seen = True }
    }
    return seen
}

def is_lower(s: str) -> bool pure {
    seen = False
    for c in s {
        if chars.is_upper(c) { return False }
        if chars.is_lower(c) { seen = True }
    }
    return seen
}

# Python's istitle: an uppercase byte may only follow a non-letter, a lowercase
# byte may only follow a letter, and at least one letter must be present.
def is_title(s: str) -> bool pure {
    prev_cased = False
    seen = False
    for c in s {
        if chars.is_upper(c) {
            if prev_cased { return False }
            seen = True
            prev_cased = True
        } else {
            if chars.is_lower(c) {
                if prev_cased == False { return False }
                seen = True
                prev_cased = True
            } else {
                prev_cased = False
            }
        }
    }
    return seen
}

def is_ascii(s: str) -> bool pure {
    for c in s { if ord(c) >= 128 { return False } }
    return True
}

def is_printable(s: str) -> bool pure {
    for c in s {
        n = ord(c)
        if n < 32 or n == 127 { return False }
    }
    return True
}

# Python's isidentifier: a letter or `_` followed by letters, digits or `_` —
# the same rule Emerald's own lexer uses (chars.is_ident_start / _cont).
def is_identifier(s: str) -> bool pure {
    if len(s) == 0 { return False }
    if chars.is_ident_start(slice(s, 0, 1)) == False { return False }
    i = 1
    while i < len(s) {
        if chars.is_ident_cont(slice(s, i, i + 1)) == False { return False }
        i = i + 1
    }
    return True
}

# --- translation -----------------------------------------------------------
#
# Python's str.maketrans / str.translate, with the table spelled out as a
# list[int] of 256 replacements: table[ord(c)] is the byte c becomes, or -1 to
# delete c. A table is just data, so it can be built once and reused.
def _identity_table() -> list[int] {
    table: list[int] = []
    i = 0
    while i < 256 {
        append(table, i)
        i = i + 1
    }
    return table
}

def make_trans(from_chars: str, to_chars: str) -> list[int] {
    table = _identity_table()
    n = len(from_chars)
    if len(to_chars) < n { n = len(to_chars) }
    i = 0
    while i < n {
        table[ord(slice(from_chars, i, i + 1))] = ord(slice(to_chars, i, i + 1))
        i = i + 1
    }
    return table
}

# A table that deletes the given bytes, for Python's `maketrans("", "", chars)`.
def make_delete(chars: str) -> list[int] {
    table = _identity_table()
    for c in chars { table[ord(c)] = -1 }
    return table
}

def translate(s: str, table: list[int]) -> str {
    b = builder.new()
    for c in s {
        r = table[ord(c)]
        if r >= 0 { builder.push(b, chr(r)) }
    }
    return builder.build(b)
}

def to_chars(s: str) -> list[str] pure {
    out: list[str] = []
    for c in s { append(out, c) }
    return out
}

# --- parsing ---------------------------------------------------------------
#
# The int() and float() builtins abort on malformed input, which is right for a
# script and wrong for a parser. These validate first and report the failure as
# a value.

def parse_int_radix(s: str, radix: int) -> Result[int, str] pure {
    t = strip(s)
    if len(t) == 0 { return { ok: False, err: "empty string" } }
    if radix < 2 or radix > 16 {
        return { ok: False, err: "radix out of range: " + str(radix) }
    }
    neg = False
    i = 0
    first = slice(t, 0, 1)
    if first == "-" or first == "+" {
        neg = first == "-"
        i = 1
    }
    if i >= len(t) { return { ok: False, err: "no digits in '" + s + "'" } }
    total = 0
    while i < len(t) {
        d = chars.digit_value(slice(t, i, i + 1))
        if d < 0 or d >= radix {
            return { ok: False, err: "invalid digit in '" + s + "'" }
        }
        total = total * radix + d
        i = i + 1
    }
    if neg { return { ok: True, val: 0 - total } }
    return { ok: True, val: total }
}

def parse_int(s: str) -> Result[int, str] pure { return parse_int_radix(s, 10) }

def parse_float(s: str) -> Result[float, str] pure {
    t = strip(s)
    if len(t) == 0 { return { ok: False, err: "empty string" } }
    i = 0
    first = slice(t, 0, 1)
    if first == "-" or first == "+" { i = 1 }
    digits = 0
    dots = 0
    exps = 0
    while i < len(t) {
        c = slice(t, i, i + 1)
        if chars.is_digit(c) {
            digits = digits + 1
        } else {
            if c == "." {
                dots = dots + 1
                if dots > 1 or exps > 0 {
                    return { ok: False, err: "malformed float '" + s + "'" }
                }
            } else {
                if c == "e" or c == "E" {
                    exps = exps + 1
                    if exps > 1 or digits == 0 {
                        return { ok: False, err: "malformed float '" + s + "'" }
                    }
                    nxt = slice(t, i + 1, i + 2)
                    if nxt == "-" or nxt == "+" { i = i + 1 }
                    digits = 0
                } else {
                    return { ok: False, err: "malformed float '" + s + "'" }
                }
            }
        }
        i = i + 1
    }
    if digits == 0 { return { ok: False, err: "malformed float '" + s + "'" } }
    return { ok: True, val: float(t) }
}

# --- escaping --------------------------------------------------------------
#
# The escape set is exactly docs/grammar.md's: \\ \" \' \n \t \r \0. Anything
# else non-printable is emitted as \xNN.

def escape(s: str) -> str {
    b = builder.new()
    for c in s {
        n = ord(c)
        if c == "\\" { builder.push(b, "\\\\") }
        elif c == "\"" { builder.push(b, "\\\"") }
        elif n == 10 { builder.push(b, "\\n") }
        elif n == 9 { builder.push(b, "\\t") }
        elif n == 13 { builder.push(b, "\\r") }
        elif n == 0 { builder.push(b, "\\0") }
        elif n < 32 or n == 127 {
            builder.push(b, "\\x")
            builder.push(b, _hex_digit(int(n / 16)))
            builder.push(b, _hex_digit(n % 16))
        } else { builder.push(b, c) }
    }
    return builder.build(b)
}

def _hex_digit(n: int) -> str pure {
    if n < 10 { return chr(48 + n) }
    return chr(87 + n)
}

def unescape(s: str) -> Result[str, str] {
    b = builder.new()
    i = 0
    while i < len(s) {
        c = slice(s, i, i + 1)
        if c != "\\" {
            builder.push(b, c)
            i = i + 1
        } else {
            if i + 1 >= len(s) {
                return { ok: False, err: "trailing backslash" }
            }
            e = slice(s, i + 1, i + 2)
            if e == "n" { builder.push(b, chr(10)) }
            elif e == "t" { builder.push(b, chr(9)) }
            elif e == "r" { builder.push(b, chr(13)) }
            elif e == "0" { builder.push(b, chr(0)) }
            elif e == "\\" { builder.push(b, "\\") }
            elif e == "\"" { builder.push(b, "\"") }
            elif e == "'" { builder.push(b, "'") }
            else { return { ok: False, err: "unknown escape \\" + e } }
            i = i + 2
        }
    }
    return { ok: True, val: builder.build(b) }
}
