# render.rald — ray_color and the render loop (book ch. 7–13).
#
# ray_color is the Markov-chain step: every sample of the chain is a Draw
# that returns the next Rng, so the whole render is a function of the seed
# (the ray-tracer design §6 #14 — true by construction, not statable).  Recursion is
# bounded by `depth`, which strictly decreases; without a termination
# checker the obligation is noted, not discharged (the ray-tracer design §6 #13).

from vec import unit
from ray import Ray
from interval import interval
from color import Color, Rgb8, color, cadd, cscale, cmul, to_rgb8
from hittable import Prim, hit_world
from camera import Camera, get_ray
from rng import Rng, Draw, next_float

type Config = { image_width: int, aspect: float,
                samples_per_pixel: int, max_depth: int }

def ray_color(r: Ray, w: list[Prim], depth: int, g: Rng) -> Draw[Color] partial {
    if depth <= 0 { return { value: color(0.0, 0.0, 0.0), rng: g } }
    t0 = interval(0.001, 1000000.0)      # 0.001 avoids self-shadowing
    if t0 == None { return { value: color(0.0, 0.0, 0.0), rng: g } }
    h = hit_world(w, r, t0)
    if h == None {
        unit_dir = unit(r.dir)
        tt = 0.5 * (unit_dir.y + 1.0)
        return { value: cadd(cscale(color(1.0, 1.0, 1.0), 1.0 - tt),
                             cscale(color(0.5, 0.7, 1.0), tt)),
                 rng: g }
    }
    s = h.mat.scatter(r, { p: h.p, normal: h.normal, front: h.front }, g)
    sv = s.value                          # Scatter | None, must narrow
    if sv == None { return { value: color(0.0, 0.0, 0.0), rng: s.rng } }
    nxt = ray_color(sv.ray, w, depth - 1, s.rng)
    return { value: cmul(sv.atten, nxt.value), rng: nxt.rng }
}

def render(cam: Camera, w: list[Prim], cfg: Config, g: Rng) -> str {
    height = int(cfg.image_width / cfg.aspect)
    out = "P3\n" + str(cfg.image_width) + " " + str(height) + "\n255\n"
    j = height - 1
    while j >= 0 {
        row = ""
        i = 0
        while i < cfg.image_width {
            col = color(0.0, 0.0, 0.0)
            s = 0
            while s < cfg.samples_per_pixel {
                du = next_float(g); g = du.rng
                dv = next_float(g); g = dv.rng
                pu = (i + du.value) / (cfg.image_width - 1)
                pv = (j + dv.value) / (height - 1)
                ray = get_ray(cam, pu, pv, g)
                g = ray.rng
                rc = ray_color(ray.value, w, cfg.max_depth, g)
                g = rc.rng
                col = cadd(col, rc.value)
                s = s + 1
            }
            rgb = to_rgb8(col, cfg.samples_per_pixel)
            row = row + str(rgb.r) + " " + str(rgb.g) + " " + str(rgb.b) + " "
            i = i + 1
        }
        out = out + row + "\n"
        j = j - 1
    }
    return out
}
