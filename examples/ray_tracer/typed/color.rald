# color.rald — colors and the total PPM conversion (PLAN.md §5.5).
#
# Color channels are nominally in [0,1] before gamma, Rgb8 in [0,255] after.
# The conversion is total *because* of the clamp: without it the function
# would be partial on over-bright pixels, and the book's ch. 8 clamp fix
# becomes, here, the thing that gives the function a total type.
#
# Chan = "r" | "g" | "b" is a Fin 3: a channel-generic fold is well-typed
# by construction (PLAN.md §6 #5).

from math import clamp
from vec import Dir

type Color = { r: float, g: float, b: float }
type Rgb8  = { r: int, g: int, b: int }
type Chan  = "r" | "g" | "b"

def color(r: float, g: float, b: float) -> Color {
    return { r: r, g: g, b: b }
}

def cadd(a: Color, b: Color) -> Color { return color(a.r + b.r, a.g + b.g, a.b + b.b) }
def cmul(a: Color, b: Color) -> Color { return color(a.r * b.r, a.g * b.g, a.b * b.b) }
def cscale(a: Color, t: float) -> Color { return color(a.r * t, a.g * t, a.b * t) }

# scene code builds colors out of random direction samples
def from_dir(d: Dir) -> Color { return color(d.x, d.y, d.z) }

# channel-generic access: narrowing over a literal union
def chan_val(c: Color, ch: Chan) -> float {
    if ch == "r" { return c.r }
    if ch == "g" { return c.g }
    return c.b
}

def _gamma_chan(c: Color, ch: Chan, samples: int) -> float {
    return clamp(sqrt(chan_val(c, ch) / samples), 0.0, 0.999)
}

# gamma-correct (sqrt) and clamp; total by construction
def to_rgb8(c: Color, samples: int) -> Rgb8 {
    return { r: int(255.999 * _gamma_chan(c, "r", samples)),
             g: int(255.999 * _gamma_chan(c, "g", samples)),
             b: int(255.999 * _gamma_chan(c, "b", samples)) }
}
