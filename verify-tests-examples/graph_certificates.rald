# graph_certificates.rald — certificates on the 5-cycle C5, checked in proof mode.
#
# HONESTY NOTE on codomain refinement. `def degree(v: V) -> 0 | 2` does NOT by
# itself prove anything about C5: the checker constrains which literals the
# body may return, but it cannot see whether 2 is the TRUE degree of v. What is
# machine-checked is the COVERAGE (every vertex is handled, via the `never`
# obligation) and the OUTPUT TYPE. The values are checked against the adjacency
# relation at runtime, over the whole finite domain, at the bottom of this file.
#
# Checked with: bin/emeraldc --check --proof graph_certificates.rald

type Bool = True | False
type V = 0 | 1 | 2 | 3 | 4

# ===========================================================================
# 1. Adjacency: a TOTAL relation on V x V (the `never` obligation is the
#    machine-checked part: it proves all five vertex rows are handled).
# ===========================================================================

def adj(a: V, b: V) -> bool pure {
    if a == 0 { if b == 1 { return True } if b == 4 { return True } return False }
    if a == 1 { if b == 0 { return True } if b == 2 { return True } return False }
    if a == 2 { if b == 1 { return True } if b == 3 { return True } return False }
    if a == 3 { if b == 2 { return True } if b == 4 { return True } return False }
    if a == 4 { if b == 0 { return True } if b == 3 { return True } return False }
    impossible: never = a
    return False
}

# ===========================================================================
# 2. Degree / Eulerian certificate.
#    Codomain `0 | 2` = "every vertex has EVEN degree". A body returning 3 here
#    is a hard type error, so the certificate cannot even be mistyped:
#        def degree(v: V) -> 0 | 2 { if v == 0 { return 3 } ... }   # E_TYPE_RETURN
# ===========================================================================

def degree(v: V) -> 0 | 2 pure {
    if v == 0 { return 2 }
    if v == 1 { return 2 }
    if v == 2 { return 2 }
    if v == 3 { return 2 }
    if v == 4 { return 2 }
    impossible: never = v
    return 0
}

# ===========================================================================
# 3. The edge set as a finite literal union.
#    `edge_id` discharges `never`, which machine-checks that the five edges
#    below are EXACTLY the edge set: no edge was forgotten and none invented.
#    (A single literal discriminant is required — narrowing on two independent
#    fields with `and` does not eliminate record alternatives.)
# ===========================================================================

type Edge =
      { id: 0, u: 0, v: 1 }
    | { id: 1, u: 1, v: 2 }
    | { id: 2, u: 2, v: 3 }
    | { id: 3, u: 3, v: 4 }
    | { id: 4, u: 4, v: 0 }

def edge_id(e: Edge) -> 0 | 1 | 2 | 3 | 4 pure {
    if e.id == 0 { return 0 }
    if e.id == 1 { return 1 }
    if e.id == 2 { return 2 }
    if e.id == 3 { return 3 }
    if e.id == 4 { return 4 }
    impossible: never = e
    return 0
}

def edge_lo(e: Edge) -> V pure { return e.u }
def edge_hi(e: Edge) -> V pure { return e.v }

# ===========================================================================
# 4. A 3-colouring (chi(C5) = 3). Again the type only fixes the output; that
#    it is PROPER is checked at runtime below.
# ===========================================================================

def color3(v: V) -> 0 | 1 | 2 pure {
    if v == 0 { return 0 }
    if v == 1 { return 1 }
    if v == 2 { return 0 }
    if v == 3 { return 1 }
    if v == 4 { return 2 }
    impossible: never = v
    return 0
}

# ===========================================================================
# 5. A matching, as a finite union (2 disjoint edges: 0-1 and 2-3).
# ===========================================================================

type Matching =
      { mid: 0, u: 0, v: 1 }
    | { mid: 1, u: 2, v: 3 }

def matching_size(m: Matching) -> 0 | 1 pure {
    if m.mid == 0 { return 0 }
    if m.mid == 1 { return 1 }
    impossible: never = m
    return 0
}

# ===========================================================================
# 6. Runtime referees over the full finite domain.
#    These are NOT proofs — they are exhaustive checks on the concrete data.
# ===========================================================================

vs: seq[V] = [0, 1, 2, 3, 4]

def symmetric_ok() -> bool pure {
    ok = True
    for a in vs {
        for b in vs { if adj(a, b) != adj(b, a) { ok = False } }
    }
    return ok
}

def irreflexive_ok() -> bool pure {
    ok = True
    for a in vs { if adj(a, a) != False { ok = False } }
    return ok
}

# degree(v) really is the number of neighbours of v
def degree_matches_adjacency() -> bool pure {
    ok = True
    for a in vs {
        n = 0
        for b in vs { if adj(a, b) { n = n + 1 } }
        if n != degree(a) { ok = False }
    }
    return ok
}

# the 3-colouring is proper: every edge has two different colours
def color3_proper() -> bool pure {
    ok = True
    for a in vs {
        for b in vs {
            if adj(a, b) { if color3(a) == color3(b) { ok = False } }
        }
    }
    return ok
}

# NON-bipartiteness witness: no assignment of 2 colours to the 5 vertices is
# proper. mask bit i is the colour of vertex i; all 2^5 = 32 are tried.
def proper2(mask: int) -> bool pure {
    ok = True
    for a in vs {
        for b in vs {
            if adj(a, b) {
                ca = (mask >> a) & 1
                cb = (mask >> b) & 1
                if ca == cb { ok = False }
            }
        }
    }
    return ok
}

def count_proper_2colorings() -> int pure {
    n = 0
    for mask in range(32) { if proper2(mask) { n = n + 1 } }
    return n
}

# the matching is a genuine matching: its edges are disjoint, distinct, present
# endpoints 0,1,2,3 must be pairwise distinct and each edge must be present
def matching_ok() -> bool pure {
    ok = True
    if adj(0, 1) != True { ok = False }
    if adj(2, 3) != True { ok = False }
    if 0 == 2 { ok = False }
    if 0 == 3 { ok = False }
    if 1 == 2 { ok = False }
    if 1 == 3 { ok = False }
    return ok
}

print("C5 adjacency symmetric:", symmetric_ok())
print("C5 adjacency irreflexive:", irreflexive_ok())
print("degree matches adjacency:", degree_matches_adjacency())
print("3-colouring is proper:", color3_proper())
print("proper 2-colourings of C5:", count_proper_2colorings(), "(0 => not bipartite)")
print("edge id of first edge:", edge_id({ id: 0, u: 0, v: 1 }))
print("endpoints of last edge:", edge_lo({ id: 4, u: 4, v: 0 }), edge_hi({ id: 4, u: 4, v: 0 }))
print("matching check:", matching_ok())
