def fib(n: int) -> int partial {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
# mutual recursion on ints: not structural descent, so both are partial
def is_even(n: int) -> bool partial {
    if n == 0 { return True }
    return is_odd(n - 1)
}
def is_odd(n: int) -> bool partial {
    if n == 0 { return False }
    return is_even(n - 1)
}
def nothing() { pass }
print(fib(15), is_even(10), is_odd(10), nothing())
