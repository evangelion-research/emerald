# Tensor construction, shape/dtype introspection, indexing, scalar access.
a = tensor([[1, 2, 3], [4, 5, 6]])
print(a)
print(dtype(a), shape(a), ndim(a))
print(item(a[0][0]), item(a[1][2]))
print(shape(a[0]))

# constructors
print(zeros([2, 2]))
print(ones([1, 3]))
print(item(full([1], 2.5)))
print(reshape(arange(6), [2, 3]))

# determinism of seeded randn
r1 = randn([3], 7)
r2 = randn([3], 7)
print(item(r1[0]) == item(r2[0]), item(r1[1]) == item(r2[1]))
