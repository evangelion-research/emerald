def greet(name: str, punctuation: str = "!") -> str {
    return f"Hello, {name}{punctuation}"
}
print((1, 2, 3), (1,)[0])
print([x * 2 for x in range(5) if x > 1])
print({str(x): x * x for x in range(3)})
print({x * 2 for x in range(4)})
d = dict([["a", 1], ["b", 2]])
d["c"] = 3
print(d, d["b"], "c" in d)

print("abcdef"[1:5:2], [0, 1, 2, 3, 4][::-1])
f = greet
print(greet("Emerald"), greet(punctuation="?", name="World"), f("Closure"))
print(5 | 2, 5 & 3, 5 ^ 1, 1 << 3, 16 >> 2)
