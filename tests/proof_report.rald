# W8: --proof-report measurement. This program exercises every field: one
# total pure function, one `partial` function, and one unsound list-covariance
# upcast (warned outside proof mode).
type Animal = { name: str }
type Dog = Animal & { bark: str }

def count(animals: list[Animal]) -> int pure { return len(animals) }
def fib(n: int) -> int partial { return n }

dogs: list[Dog] = [{ name: "rex", bark: "woof" }]
print(count(dogs), fib(3))
