# W4: mutual recursion has no single structural parameter to descend on, so it
# is rejected unless both functions opt out with `partial`.
def is_even(n: int) -> bool {
    if n == 0 { return True }
    return is_odd(n - 1)
}
def is_odd(n: int) -> bool {
    if n == 0 { return False }
    return is_even(n - 1)
}
