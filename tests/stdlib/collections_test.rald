import set
import sort

a = set.from_list(["x", "y", "x"])
b = set.from_list(["y", "z"])
print(set.size(a), set.has(a, "x"), set.has(a, "q"))
print(set.sorted_elements(set.union(a, b)), set.sorted_elements(set.intersect(a, b)))
print(set.sorted_elements(set.difference(a, b)), set.is_subset(set.from_list(["y"]), a))
set.add(a, "w")
print(set.remove(a, "w"), set.remove(a, "w"), set.is_empty(set.new_set()))
print(set.sorted_elements(set.from_list([])))

xs = [5, 3, 9, 1, 3]
print(sort.sorted_ints(xs), sort.sorted_strs(["pear", "apple", "fig"]))
print(sort.sorted_desc(xs, sort.less_int), sort.is_sorted(sort.sorted_ints(xs), sort.less_int))
print(sort.is_sorted(xs, sort.less_int))
print(sort.binary_search(sort.sorted_ints(xs), 9, sort.less_int),
      sort.binary_search([1, 2], 7, sort.less_int))
print(sort.lower_bound([1, 3, 5], 4, sort.less_int), sort.lower_bound([], 4, sort.less_int))
print(sort.sort_by_key(["bbb", "a", "cc"], (w: str) => len(w), sort.less_int))
print(sort.sorted_ints([]), sort.sorted_ints([1]), sort.sorted_floats([2.5, 1.5]))

# stability: equal keys keep their input order
pairs = [{ k: 1, tag: "first" }, { k: 0, tag: "x" }, { k: 1, tag: "second" }]
by_k = sort.sort_by_key(pairs, (p: { k: int, tag: str }) => p.k, sort.less_int)
print(by_k[1].tag, by_k[2].tag)

# a bigger sort, to exercise more than one merge pass
big: list[int] = []
seed = 7
for i in range(50) {
    seed = (seed * 1103515245 + 12345) % 2147483648
    append(big, seed % 1000)
}
sorted_big = sort.sorted_ints(big)
print(len(sorted_big), sort.is_sorted(sorted_big, sort.less_int))
