import sort

m = dict()
m["one"] = 1
m["two"] = 2
m["one"] = 11
print(len(m), "one" in m, "nope" in m)
print(m["two"], m["one"])
keys: list[str] = []
vals: list[int] = []
for k in m { append(keys, k); append(vals, m[k]) }
print(sort.sorted_strs(keys), sort.sorted_ints(vals))

# force several growths
big = dict()
for i in range(200) { big["k" + str(i)] = "v" + str(i) }
print(len(big), big["k137"])
ok = True
for i in range(200) { if big["k" + str(i)] != "v" + str(i) { ok = False } }
print("all survived growth:", ok)

counts = dict()
for w in ["a", "b", "a", "c", "a"] {
    if w in counts { counts[w] = counts[w] + 1 }
    else { counts[w] = 1 }
}
print(counts["a"], counts["b"])

a = dict([["x", 1], ["y", 2]])
b = dict([["y", 20]])
merged = dict(a)
for k in b { merged[k] = b[k] }
print(merged["x"], merged["y"], len(dict()))
