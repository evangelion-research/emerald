# Proof mode is whole-program: it checks every linked module, not just the
# entry. Under the current termination discipline, the standard library no
# longer passes proof mode as a whole. The non-trivial `while` loops that
# remain — math.gcd and the exp/log range reduction, sort's merge and binary
# search, strings.find and read_lines, lists.chunk, builder's tree join, and
# result's retry — cannot be shown to terminate by the monotone-counter rule,
# and `for i in range(n)` (no step, no descent) cannot express them. That is
# exactly the finding this phase exists to surface; `--proof-report` (W8) is
# what quantifies it.
#
# What *does* survive proof mode unchanged is the leaf module `chars`, which is
# pure and loop-free. This test still means something real: a single `xs = []`
# or `partial` anywhere in a linked module takes proof mode away from every
# program that imports it, so the modules that *can* pass remain a property
# worth a regression test.

import chars

def is_all_digits(s: str) -> bool pure {
    for c in s {
        if chars.is_digit(c) == False { return False }
    }
    return True
}

def shouted(c: str) -> str pure { return chars.to_upper(c) }

print(chars.to_lower("ABC"), chars.is_digit("7"), chars.digit_value("f"))
print(is_all_digits("42"), is_all_digits("4x"), shouted("hi"))
