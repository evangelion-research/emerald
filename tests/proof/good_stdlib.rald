# Proof mode is whole-program: it checks every linked module, not just the
# entry. So this passing means the standard library itself is free of `any` and
# of `partial` — a property worth a regression test, because a single `xs = []`
# in a stdlib module would silently take proof mode away from every program
# that imports it.

import math
import chars
import strings
import lists
import dict
import sort
import set
import path
import io
import sys
import builder
from result import Result, Option, unwrap_or
from builder import Builder

def normalized(x: float) -> float pure { return math.clamp(x, 0.0, 1.0) }

def leading_digits(s: str) -> int pure {
    n = 0
    while n < len(s) {
        if chars.is_digit(strings.take(strings.drop(s, n), 1)) == False { return n }
        n = n + 1
    }
    return n
}

def widths(words: list[str]) -> list[int] {
    out: list[int] = []
    for w in words { append(out, len(w)) }
    return sort.sorted_ints(out)
}

# §1.2 local-mutation purity: proof-mode code can *build* now. Each of these
# would have been E_TYPE_PURE_CALL before the safe-escape rule landed — they
# are the regression test that the stdlib's building half is pure.
def split_words(s: str) -> list[str] pure { return strings.split(s, " ") }
def doubled(xs: list[int]) -> list[int] pure { return lists.concat(xs, xs) }
def unique_of(xs: list[int]) -> list[int] pure { return lists.unique(xs) }
def word_chars(s: str) -> list[str] pure { return strings.to_chars(s) }
def joined_path(parts: list[str]) -> str pure { return path.join_all(parts) }
def built(b: Builder) -> str pure { return builder.build(b) }

print(normalized(1.5), leading_digits("42x"), widths(["bbb", "a"]))
print(unwrap_or(strings.parse_int("7"), 0), path.ext("main.rald"), lists.sum([1, 2]))
print(split_words("a b c"), doubled([1]), unique_of([1, 2, 1]), word_chars("hi"), joined_path(["a", "b"]))
b = builder.new()
builder.push(b, "x")
print(built(b))
